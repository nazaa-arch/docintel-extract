# DocIntel Extract Configuration
# Extraction provider: local | ollama | gemini | openai
DOCINTEL_PROVIDER=local

# Model name for Vision/LLM providers
# Examples: qwen2.5vl:7b (ollama), gemini-2.0-flash (gemini), gpt-4o-mini (openai)
DOCINTEL_MODEL=qwen2.5vl:7b

# Local Ollama endpoint
DOCINTEL_OLLAMA_BASE_URL=http://localhost:11434

# Optional external Vision/LLM provider API keys
DOCINTEL_GEMINI_API_KEY=
DOCINTEL_OPENAI_API_KEY=
DOCINTEL_OPENAI_BASE_URL=https://api.openai.com/v1

# Confidence threshold below which documents are routed to the HITL review queue
DOCINTEL_REVIEW_CONFIDENCE_THRESHOLD=0.80

# Storage paths
DOCINTEL_DB_PATH=data/docintel_review.db
DOCINTEL_UPLOAD_DIR=data/uploads
DOCINTEL_SAMPLES_DIR=data/samples

# Server & HTTP settings
DOCINTEL_HOST=0.0.0.0
DOCINTEL_PORT=8000
DOCINTEL_HTTP_TIMEOUT_SECONDS=45.0
